# --- Model server (OpenAI-compatible) ---
# Defaults point at the ollama container. Set a hosted URL and key to compare against a hosted model.
LLM_BASE_URL=http://ollama:11434/v1
LLM_API_KEY=ollama
DEFAULT_MODEL=gemma3:4b
# Other models a conversation request may name, comma-separated
MODELS=
# Changing this means indexing everything again (python -m scripts.reindex)
EMBEDDING_MODEL=bge-m3

# --- Assistant ---
SYSTEM_PROMPT=You are a helpful assistant. Be concise and practical.
# Sections given to the model per question
TOP_K=5
# Sites allowed to call the api from a browser, comma-separated
ALLOWED_ORIGINS=

# --- Knowledge base ---
QDRANT_URL=http://qdrant:6333
# The Qdrant collection holding the index
COLLECTION=kb
# Folder of markdown pages, inside the container (./kb is mounted at /app/kb)
KB_ROOT=kb

# --- Users ---
# Defaults to the postgres container
DATABASE_URL=postgresql+psycopg2://local_model:local_model@postgres:5432/local_model
# Signs login tokens; nobody can log in while it is empty. Generate one with: openssl rand -hex 32
SECRET_KEY=
# The admin created when the api starts, unless a user with this email exists. The password (8 to 72
# characters) is only used to create the account; changing it here later does not change the account.
ADMIN_EMAIL=
ADMIN_PASSWORD=
