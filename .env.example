# --- Model server (OpenAI-compatible) ---
# Defaults point at the ollama container. Set a hosted URL and key to compare against a hosted model.
LLM_BASE_URL=http://ollama:11434/v1
LLM_API_KEY=ollama
DEFAULT_MODEL=gemma3:4b
# Changing this means re-indexing every project
EMBEDDING_MODEL=bge-m3

# --- Search index ---
QDRANT_URL=http://qdrant:6333

# --- Admin ---
# Required for POST /v1/<project>/index
ADMIN_TOKEN=
